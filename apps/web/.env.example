# 数据库（Neon/Supabase 托管 PostgreSQL）
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:pass@host/db

# 会话与 Cookie 签名密钥
DEVICE_COOKIE_SECRET=
ADMIN_SESSION_SECRET=

# LLM 供应商兜底密钥（正式配置在管理后台 admin_settings，AES-GCM 加密存储）
LLM_API_KEY_ZHIPU=

# 定时任务鉴权
CRON_SECRET=
